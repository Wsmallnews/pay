{
    "name": "wsmallnews/pay",
    "description": "Wsmallnews system pay modules",
    "keywords": [
        "Wsmallnews",
        "laravel",
        "pay",
        "filament",
        "php"
    ],
    "homepage": "https://github.com/wsmallnews/pay",
    "support": {
        "issues": "https://github.com/wsmallnews/pay/issues",
        "source": "https://github.com/wsmallnews/pay"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "smallnews",
            "email": "1371606921@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "wsmallnews/support": "^1.0",
        "yansongda/pay": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0 || ^8.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-arch": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0 || ^4.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Wsmallnews\\Pay\\": "src/",
            "Wsmallnews\\Pay\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wsmallnews\\Pay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wsmallnews\\Pay\\PayServiceProvider"
            ],
            "aliases": {
                "Pay": "Wsmallnews\\Pay\\Facades\\Pay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
